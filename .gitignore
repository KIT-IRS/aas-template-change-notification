.agents/

# Windows NTFS "mark of the web" metadata materialized as literal files
*:Zone.Identifier

# IDE / editor local state
.idea
# No trailing slash: the devcontainer bind-mounts /dev/null over this path, so it
# is a character device rather than a directory and `.vscode/` cannot match it.
.vscode

# Devcontainer bind-mounts: /dev/null is mounted over these three paths, so they
# appear as character devices (crw-rw-rw-, 1:3) rather than files. `git add .`
# refuses them outright — "can only add regular files, symbolic links or
# git-directories" — which fails the whole command and, with it, every Speckit
# auto-commit hook. This repository has no submodules, so nothing real is hidden.
.gitmodules
.mcp.json

# Personal shell/env dotfiles that don't belong in the project tree
.bashrc
.bash_profile
.zshrc
.zprofile
.profile
.gitconfig
.ripgreprc

# Claude Code local session/agent scaffolding (personal, not shared)
.claude/agents
.claude/commands
.claude/hooks
.claude/launch.json
.claude/loop.md
.claude/output-styles
.claude/routines
.claude/scheduled_tasks.json
.claude/workflows
# Python build/test artefacts
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Claude Code worktrees and the vendored metamodel library clone
.claude/worktrees/
aas-core3.1-python/

# mcn-coevolution writes refused payloads here at runtime.
quarantine/
.claude/settings.local.json

# The evidence harness writes run directories here. Ignored in full (author
# decision, 2026-09-14): evidence is measured, not committed — a final run is
# copied out of the tree or excepted by hand when it is wanted in the thesis.
validation/evidence/

# The presentation demo derives this file live (demonstration/README.md); the committed
# reference copy is productcard-1-to-2.atomic.json.
demonstration/chains/*.derived.json

# Manuscript and internal notes: not part of the public repository
ressources/article.pdf
ressources/HANDOVER_atomic_operators.md
